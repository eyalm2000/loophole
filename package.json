{
  "name": "loophole",
  "version": "1.0.0",
  "description": "DNS-over-HTTPS on Android with Private DNS.",
  "private": true,
  "type": "module",
  "main": "worker/index.ts",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:worker\" \"npm:dev:ui\"",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1",
    "dev:ui": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy"
  },
  "keywords": [
    "nextdns",
    "doh",
    "doh3",
    "ddr",
    "dns-over-https",
    "cloudflare-workers",
    "android",
    "private-dns"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
